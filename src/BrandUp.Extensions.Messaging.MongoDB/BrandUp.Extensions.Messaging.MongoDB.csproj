<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>BrandUp.Extensions.Messaging.MongoDB</Title>
    <Description>MongoDB checkpoint and shard lease stores for BrandUp.Extensions.Messaging stream readers: keeps the read position of every shard per consumer group, so a reader resumes where it stopped, and leases shards so several instances of one group can read a stream together.</Description>
    <PackageTags>messaging;stream;checkpoint;lease;kinesis;datastreams;mongodb</PackageTags>
    <!-- Transitive pinning would promote Microsoft.Extensions.Logging.Abstractions (via MongoDB.Driver) to a package dependency -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrandUp.Extensions.Messaging.Abstraction\BrandUp.Extensions.Messaging.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrandUp.Extensions.Messaging.MongoDB.Tests" />
  </ItemGroup>

</Project>
