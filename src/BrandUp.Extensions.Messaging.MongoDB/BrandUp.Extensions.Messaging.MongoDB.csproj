<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrandUp.Extensions.Messaging</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Dmitry Kovyazin</Authors>
    <Company>BrandUp</Company>
    <Title>BrandUp.Extensions.Messaging.MongoDB</Title>
    <Description>MongoDB checkpoint store for BrandUp.Extensions.Messaging stream readers: keeps the read position of every shard per consumer group, so a reader resumes where it stopped.</Description>
    <PackageTags>messaging;stream;checkpoint;kinesis;datastreams;mongodb</PackageTags>
    <PackageProjectUrl>https://github.com/brandup/BrandUp.Extensions.Messaging</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrandUp.Extensions.Messaging.Abstraction\BrandUp.Extensions.Messaging.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrandUp.Extensions.Messaging.MongoDB.Tests" />
  </ItemGroup>

</Project>
