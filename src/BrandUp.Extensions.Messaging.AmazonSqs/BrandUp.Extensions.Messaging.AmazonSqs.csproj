<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrandUp.Extensions.Messaging</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Dmitry Kovyazin</Authors>
    <Company>BrandUp</Company>
    <Title>BrandUp.Extensions.Messaging.AmazonSqs</Title>
    <Description>SQS-compatible message queue implementation using AWS SDK. Supports Amazon SQS, Yandex Message Queue and other SQS-compatible providers. Includes typed queues, hosted consumers, FIFO and dead-letter queues.</Description>
    <PackageTags>sqs;messaging;queue;awssdk;yandexcloud;ymq;cloud</PackageTags>
    <PackageProjectUrl>https://github.com/brandup/BrandUp.Extensions.Messaging</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AwsConnection.cs" Link="Internals\AwsConnection.cs" />
    <Compile Include="..\Shared\CredentialsRegistrations.cs" Link="Internals\CredentialsRegistrations.cs" />
    <Compile Include="..\Shared\RegistrationGuards.cs" Link="Internals\RegistrationGuards.cs" />
    <Compile Include="..\Shared\MessagingContexts.cs" Link="Internals\MessagingContexts.cs" />
    <Compile Include="..\Shared\MessagingConnectionCheck.cs" Link="Internals\MessagingConnectionCheck.cs" />
    <Compile Include="..\Shared\PublishBatches.cs" Link="Internals\PublishBatches.cs" />
    <Compile Include="..\Shared\SqsLimits.cs" Link="Internals\SqsLimits.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrandUp.Extensions.Messaging.Abstraction\BrandUp.Extensions.Messaging.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrandUp.Extensions.Messaging.AmazonSqs.Tests" />
  </ItemGroup>

</Project>
